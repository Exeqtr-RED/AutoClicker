<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="AutoClicker"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="Автокликер на AccessibilityService"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <!-- GroupBox: выбор режима -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:background="@drawable/groupbox_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Режим запуска"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSingle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_secondary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:text="Single Target" />

            <Button
                android:id="@+id/btnMulti"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_secondary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:text="Multi Target&#10;with Swipe" />
        </LinearLayout>
    </LinearLayout>

    <!-- GroupBox: разрешения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/groupbox_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Разрешения"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_secondary"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:text="Разрешение на оверлей" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:background="@drawable/btn_secondary"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:text="Включить службу (Accessibility)" />
    </LinearLayout>

    <!-- Кнопка Назад -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:background="@android:color/transparent"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:textAllCaps="false"
        android:text="Назад" />
</LinearLayout>
