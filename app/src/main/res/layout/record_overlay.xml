<?xml version="1.0" encoding="utf-8"?>
<!-- Оверлей записи MTWS: затемнённая область перехвата касаний + плашка-статус.
     ФИЧА: во время записи каждый жест тут же воспроизводится на экране
     (живой предпросмотр) — список реально скроллится, тапы реально нажимаются.
     ФИКС: стоп-кнопка вынесена в отдельное окно (record_stop.xml) — на время
     предпросмотра это окно получает FLAG_NOT_TOUCHABLE. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/recordArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A00E676" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="● Запись: жесты выполняются и сохраняются"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_orange" />
</FrameLayout>
