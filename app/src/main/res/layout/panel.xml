<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная ВЕРТИКАЛЬНАЯ панель (как в OP Auto Clicker):
     шапка-ручка / ▶ Старт-Стоп / ⏸ Пауза / ☰ пресеты · ⊕ прицел · ✕ закрыть -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Шапка: он же ручка перетаскивания -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <!-- ФИКС (v23): серый по умолчанию (простой). Раньше стоял красный —
             цвет читался как «идёт запись». Реальный цвет всегда задаёт
             служба (updatePanelState): запись = красный, работа = зелёный,
             пауза = оранжевый, простой = серый -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="●"
            android:textSize="16sp"
            android:textColor="#FF9E9E9E" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0 · 00:00"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
            android:singleLine="true" />

        <TextView
            android:id="@+id/minimizeBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="—"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_icon" />
    </LinearLayout>

    <!-- Старт / Стоп — иконка play/stop вместо надписи (вектор вместо текста: символ ⏸/▶ может рендериться эмодзи) -->
    <ImageButton
        android:id="@+id/toggleBtn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_primary"
        android:stateListAnimator="@null"
        android:src="@drawable/ic_play"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Старт / Стоп" />

    <!-- Пауза — под Стартом (вертикальная компоновка); при паузе показывает ic_play (продолжить) -->
    <ImageButton
        android:id="@+id/pauseBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/btn_secondary"
        android:stateListAnimator="@null"
        android:src="@drawable/ic_pause"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:contentDescription="Пауза / Продолжить"
        android:enabled="false" />

    <!-- Нижний ряд: выбор пресета · прицел · закрыть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/presetsBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="☰"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/crosshairBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="⊕"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/closeBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
