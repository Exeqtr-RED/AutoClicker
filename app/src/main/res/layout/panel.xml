<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная ВЕРТИКАЛЬНАЯ панель (как в OP Auto Clicker):
     шапка-ручка / имя пресета / ◀ ▶ ▶▶ (навигация MTWS) /
     прогресс MTWS или задержка ST (размером с play) / ☰ ⊕ ✕
     (v25: кнопка паузы удалена — её место заняла строка прогресса MTWS) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Шапка: он же ручка перетаскивания -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <!-- ФИКС (v23): серый по умолчанию (простой). Раньше стоял красный —
             цвет читался как «идёт запись». Реальный цвет всегда задаёт
             служба (updatePanelState): запись = красный, работа = зелёный,
             простой = серый (v25: пауза удалена) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="●"
            android:textSize="16sp"
            android:textColor="#FF9E9E9E" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0 · 00:00"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
            android:singleLine="true" />

        <TextView
            android:id="@+id/minimizeBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="—"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_icon" />
    </LinearLayout>

    <!-- ФИЧА (v24/v25): имя выбранного пресета — видно, что запустит play;
         текст ЦЕНТРИРУЕТСЯ (v25). Тап по строке открывает тот же список
         пресетов, что и ☰ -->
    <TextView
        android:id="@+id/tvPresetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Пресет не выбран"
        android:textSize="11sp"
        android:textColor="#B3FFFFFF"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- ФИЧА (v24): Старт/Стоп + навигация по действиям MTWS.
         Для Single Target кнопки ◀/▶ скрыты (gone) — play занимает всю ширину.
         Для MTWS: слева от play «предыдущее действие», справа — «следующее» -->
    <LinearLayout
        android:id="@+id/playNavRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- ФИЧА (v24): выполнить ПРЕДЫДУЩЕЕ действие пресета (MTWS).
             На первом действии повторяет его. Вектор вместо текста «⏮»:
             текстовые глифы могут рендериться эмодзи (урок кнопки play) -->
        <ImageButton
            android:id="@+id/btnPrevAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:src="@drawable/ic_prev"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Предыдущее действие" />

        <ImageButton
            android:id="@+id/toggleBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:src="@drawable/ic_play"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Старт / Стоп" />

        <!-- ФИЧА (v24): перейти к СЛЕДУЮЩЕМУ действию пресета (MTWS).
             После последнего действия — к началу списка -->
        <ImageButton
            android:id="@+id/btnNextAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:src="@drawable/ic_next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Следующее действие" />
    </LinearLayout>

    <!-- ФИЧА (v25): строка ПРОГРЕССА MTWS — на месте бывшей кнопки паузы.
         В playback: «Тап 2/5 · 3,4 с» — номер выполняемого действия и
         обратный отсчёт до следующего; в простое: «Действий: N».
         Для ST-пресетов скрыта — её место занимает строка задержки.
         Размер — как у кнопки play (44dp), ширина во всю панель -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Действий: —"
        android:textSize="12sp"
        android:textColor="#B3FFFFFF"
        android:singleLine="true"
        android:visibility="gone" />

    <!-- ФИЧА (v24/v25): строка задержки между кликами (только Single Target).
         Показывает текущее значение (с разбросом, если включён); тап открывает
         редактор с клавиатурой — прямо из плавающей панели, без приложения.
         v25: высота 44dp — РАЗМЕР С КНОПКУ PLAY -->
    <TextView
        android:id="@+id/tvDelayValue"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Задержка: — мс"
        android:textSize="12sp"
        android:textColor="#B3FFFFFF"
        android:singleLine="true"
        android:visibility="gone" />

    <!-- Нижний ряд: выбор пресета · прицел · закрыть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/presetsBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="☰"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/crosshairBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="⊕"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/closeBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
