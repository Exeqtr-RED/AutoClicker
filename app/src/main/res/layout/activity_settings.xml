<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />

        <!-- GroupBox: пресеты -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/groupbox_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сохранённые пресеты"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:paddingTop="6dp"
                android:text="Клик — загрузить, долгий тап — удалить" />
        </LinearLayout>

        <!-- GroupBox: настройки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/groupbox_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Новый пресет"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etName"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Название пресета"
                android:textColor="@color/text_primary" />

            <!-- Блок записи (только для MTWS): запись + редактирование действий -->
            <LinearLayout
                android:id="@+id/llRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Запись действий (тапы и свайпы)"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_primary"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:text="Начать запись" />

                <TextView
                    android:id="@+id/tvRecCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Записано действий: 0"
                    android:paddingTop="6dp" />

                <!-- Редактируемый список записанных действий (строки создаются в коде) -->
                <LinearLayout
                    android:id="@+id/llActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/tvActionsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:paddingTop="2dp"
                    android:text="Число у действия — задержка после него (мс). Пауза перед повторным запуском пресета задаётся полем «Периодичность запуска»." />

                <Button
                    android:id="@+id/btnClearActions"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_secondary"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:text="Очистить действия" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тайминг:"
                android:textColor="@color/text_secondary"
                android:paddingTop="8dp" />

            <RadioGroup
                android:id="@+id/rgTiming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbInfinite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:checked="true"
                    android:text="Никогда не останавливаться"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Длительность"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbCycles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Количество циклов"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/llDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etHours"
                    android:background="@drawable/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:hint="ЧЧ"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text=" : " />
                <EditText
                    android:id="@+id/etMinutes"
                    android:background="@drawable/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:hint="ММ"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text=" : " />
                <EditText
                    android:id="@+id/etSeconds"
                    android:background="@drawable/bg_input"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:hint="СС"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCycles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCycles"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="Количество циклов"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- Периодичность запуска (только для MTWS): пауза между прогонами пресета.
                 ФИЧА: два поля — минуты и секунды (вместо одного поля в мс) -->
            <LinearLayout
                android:id="@+id/llRepeatRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Периодичность запуска" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/etRepeatMin"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:hint="Мин"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text=" мин "
                        android:layout_marginStart="4dp" />

                    <EditText
                        android:id="@+id/etRepeatSec"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="2"
                        android:hint="Сек"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text=" сек "
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:paddingTop="2dp"
                    android:text="Пауза после завершения всех действий перед повторным запуском пресета" />
            </LinearLayout>

            <!-- Задержка с подписью слева (только для ST, в МИЛЛИСЕКУНДАХ — Task 24:
                 пользователь вернул ST на мс; в MTWS строка скрыта, там задержки
                 задаются у каждого действия в минутах+секундах) -->
            <LinearLayout
                android:id="@+id/llDelayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Задержка" />

                <EditText
                    android:id="@+id/etDelay"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:text="100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="мс"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Кнопка выбора точки (только для ST) -->
            <Button
                android:id="@+id/btnPickPoint"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_secondary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:text="Выберите место для тапа" />

            <TextView
                android:id="@+id/tvPickedPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:text="Точка не выбрана" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_secondary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:text="Сохранить пресет" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_primary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:text="ЗАПУСТИТЬ" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:minWidth="0dp"
                android:background="@drawable/btn_primary"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:visibility="gone"
                android:text="ОСТАНОВИТЬ" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
