<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ФИКС (Task 25): тема всегда тёмная (parent Dark, а не DayNight) —
         при светлой системной теме поля ввода получали чёрный текст на
         тёмном фоне. values-night теперь идентичен values -->
    <style name="Base.Theme.AutoClicker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
