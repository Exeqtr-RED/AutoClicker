<?xml version="1.0" encoding="utf-8"?>
<!-- Плавающая панель: тёмное стекло + неоновая градиентная кромка cyan → purple -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешний слой: градиентное неоновое кольцо -->
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#8C38BDF8"
                android:endColor="#8CA855F7"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Внутренний слой: стеклянная заливка -->
    <item
        android:top="1.5dp"
        android:bottom="1.5dp"
        android:start="1.5dp"
        android:end="1.5dp">
        <shape>
            <solid android:color="@color/panel_bg" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
