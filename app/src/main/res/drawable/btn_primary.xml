<?xml version="1.0" encoding="utf-8"?>
<!-- Главная кнопка: градиентная неоновая пилюля cyan → blue → purple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="@color/accent_cyan"
                android:centerColor="@color/accent_blue"
                android:endColor="@color/accent_purple"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</ripple>
