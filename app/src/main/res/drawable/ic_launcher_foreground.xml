<?xml version="1.0" encoding="utf-8"?>
<!-- Секира-лабрис по референсу пользователя (sek.jpg): диагональное древко,
     два симметричных полумесяца, шип наверху, кольцо-навершие на торце.
     Стиль Liquid Glass: неоновые лезвия cyan → purple, сталь, тёмное стекло. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:rotation="36"
        android:pivotX="54"
        android:pivotY="58">

        <!-- Шип на обухе (навершие) -->
        <path
            android:pathData="M54,20 L56.5,29 L51.5,29 Z"
            android:fillColor="#FFF2F6FB" />

        <!-- Древко: стальная капсула по диагонали -->
        <path android:pathData="M51.2,31 a2.8,2.8 0 0 1 5.6,0 v50 a2.8,2.8 0 0 1 -5.6,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="51.2"
                    android:startY="28"
                    android:endX="56.8"
                    android:endY="84"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFAEB8C6" />
            </aapt:attr>
        </path>

        <!-- Втулка-кольцо ниже головы (как на референсе) -->
        <path
            android:pathData="M50.2,46.5 h7.6 a1.5,1.5 0 0 1 1.5,1.5 v0.5 a1.5,1.5 0 0 1 -1.5,1.5 h-7.6 a1.5,1.5 0 0 1 -1.5,-1.5 v-0.5 a1.5,1.5 0 0 1 1.5,-1.5 Z"
            android:fillColor="#FFC3CCDA" />

        <!-- Правое лезвие-полумесяц: неон -->
        <path android:pathData="M56,23 C66,22 74,28 74.4,36 C74,40.5 66,44.5 56,43.8 C61.5,41.5 64,37 62.8,32 C61.8,27.5 59.5,24.5 56,23 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="56"
                    android:startY="23"
                    android:endX="74.5"
                    android:endY="44"
                    android:startColor="#FF4DD8FF"
                    android:endColor="#FFA855F7" />
            </aapt:attr>
        </path>

        <!-- Левое лезвие: зеркало правого -->
        <group
            android:scaleX="-1"
            android:pivotX="54">
            <path android:pathData="M56,23 C66,22 74,28 74.4,36 C74,40.5 66,44.5 56,43.8 C61.5,41.5 64,37 62.8,32 C61.8,27.5 59.5,24.5 56,23 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="56"
                        android:startY="24"
                        android:endX="73"
                        android:endY="42"
                        android:startColor="#FF4DD8FF"
                        android:endColor="#FFA855F7" />
                </aapt:attr>
            </path>
        </group>

        <!-- Голова-втулка в месте соединения -->
        <path
            android:pathData="M54,29.5 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z"
            android:fillColor="#FFE8EDF4" />

        <!-- Кольцо-навершие на торце рукояти -->
        <path
            android:fillType="evenOdd"
            android:pathData="M54,85.5 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z M54,85.5 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z"
            android:fillColor="#FFDDE4EE" />
    </group>
</vector>
