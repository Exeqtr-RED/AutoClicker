<?xml version="1.0" encoding="utf-8"?>
<!-- Поле ввода: тёмное стекло с неоновой градиентной кромкой (как Text Field из кита) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешний слой: градиентная кромка -->
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#4D38BDF8"
                android:endColor="#4DA855F7"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Внутренний слой: стеклянная заливка -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:start="1dp"
        android:end="1dp">
        <shape>
            <solid android:color="@color/glass_input" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
