<?xml version="1.0" encoding="utf-8"?>
<!-- Фон адаптивной иконки: тёмное стекло + неоновое свечение за лезвием -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- База: вертикальный градиент тёмного стекла -->
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#FF1B1E27"
                android:endColor="#FF0A0B0F" />
        </aapt:attr>
    </path>

    <!-- Свечение за лезвием (cyan, к краям прозрачнее) -->
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="68"
                android:centerY="38"
                android:gradientRadius="48"
                android:startColor="#3826C6DA"
                android:endColor="#0026C6DA" />
        </aapt:attr>
    </path>
</vector>
