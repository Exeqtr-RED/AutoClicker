<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- ФИКС (v18): поднять ЗАДАЧУ редактора целиком (ActivityManager.moveTaskToFront)
         из службы после выбора точки / остановки записи -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- ФИКС (v40): haptic() зовёт Vibrator.vibrate — без этого permission
         на Android 12+ система логирует warning "Missing permissions required
         by Vibrator.vibrate: android.permission.VIBRATE" (без бросания
         исключения, runCatching не ловит) и вибро тихо не работает.
         Normal permission (Protection level: normal) — granted at install,
         runtime prompt НЕ нужен -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ФИЧА (Task): автообновление с GitHub.
         INTERNET — качать APK и опрашивать GitHub API для последнего release.
         Normal permission (Protection level: normal) — granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ФИЧА (Task): разрешение на установку APK из неизвестных источников.
         Signature permission (Protection level: signature) — на Android 8+
         требует явного системного диалога (Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES),
         пользователь должен разрешить установку для нашего приложения.
         Без этого permission Intent.ACTION_INSTALL_PACKAGE тихо откажет. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoClicker"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <service
            android:name=".ClickService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ФИЧА (Task): FileProvider для отдачи скачанного APK системному
             установщику (Intent.ACTION_INSTALL_PACKAGE / View). Начиная с
             Android 7 (API 24), file:// Uri запрещён — нужен content://
             через FileProvider. Конфигурация в res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
